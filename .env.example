# Copy to .env and fill in real values. Never commit the real .env file.

# SQLAlchemy connection string for the PostgreSQL database.
# Local dev example (adjust user/password/host/port/dbname):
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/razorrecon

# --- AI-assisted layer (Phase 6A, optional) ---
# Leave ANTHROPIC_API_KEY unset/empty to run with AI features disabled —
# reconciliation, the dashboard, and human review all work fully without
# it. The /ai/* endpoints return a structured "ai_available: false"
# response instead of an error when no key is configured.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 if unset. See docs/ai-architecture.md.
AI_MODEL=claude-opus-5
